<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>PatrickStevens</Authors>
    <Copyright>Copyright (c) Patrick Stevens 2025</Copyright>
    <Description>A library for expressing computations that can change efficiently based on their inputs over time.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Smaug123/WoofWare.Incremental</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>light.png</PackageIcon>
    <PackageTags>incremental;reactive</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs"/>
    <Compile Include="FakeUnit.fs"/>
    <Compile Include="Type.fs"/>
    <Compile Include="Map.fs"/>
    <Compile Include="List.fs"/>
    <Compile Include="Seq.fs"/>
    <Compile Include="Sequence.fs"/>
    <Compile Include="Gc.fs"/>
    <Compile Include="ThreadSafeQueue.fs"/>
    <Compile Include="Staged.fs"/>
    <Compile Include="Stack.fs"/>
    <Compile Include="Debug.fs"/>
    <Compile Include="StepFunction.fsi"/>
    <Compile Include="StepFunction.fs"/>
    <Compile Include="BeforeOrAfter.fs"/>
    <Compile Include="RaisedException.fsi"/>
    <Compile Include="RaisedException.fs"/>
    <Compile Include="StabilizationNum.fsi"/>
    <Compile Include="StabilizationNum.fs"/>
    <Compile Include="OnUpdateHandler.fsi"/>
    <Compile Include="OnUpdateHandler.fs"/>
    <Compile Include="NodeId.fs"/>
    <Compile Include="Cutoff.fsi"/>
    <Compile Include="Cutoff.fs"/>
    <Compile Include="DotUserInfo.fsi"/>
    <Compile Include="DotUserInfo.fs"/>
    <Compile Include="Types.fs"/>
    <Compile Include="NodeHelpers.fs"/>
    <Compile Include="InternalObserver.fsi"/>
    <Compile Include="InternalObserver.fs"/>
    <Compile Include="At.fs"/>
    <Compile Include="IfThenElse.fs"/>
    <Compile Include="Bind.fsi"/>
    <Compile Include="Bind.fs"/>
    <Compile Include="Expert.fsi"/>
    <Compile Include="Expert.fs"/>
    <Compile Include="Join.fs"/>
    <Compile Include="Scope.fsi"/>
    <Compile Include="Scope.fs"/>
    <Compile Include="AtIntervals.fs"/>
    <Compile Include="Freeze.fs"/>
    <Compile Include="Snapshot.fs"/>
    <Compile Include="ArrayFold.fsi"/>
    <Compile Include="ArrayFold.fs"/>
    <Compile Include="StepFunctionNode.fsi"/>
    <Compile Include="StepFunctionNode.fs"/>
    <Compile Include="AlarmValueAction.fs"/>
    <Compile Include="AlarmValue.fs"/>
    <Compile Include="UnorderedArrayFold.fsi"/>
    <Compile Include="UnorderedArrayFold.fs"/>
    <Compile Include="Var.fsi"/>
    <Compile Include="Var.fs"/>
    <Compile Include="Kind.fsi"/>
    <Compile Include="Kind.fs"/>
    <Compile Include="Observer.fsi"/>
    <Compile Include="Observer.fs"/>
    <Compile Include="Node.fs"/>
    <Compile Include="RecomputeHeap.fsi"/>
    <Compile Include="RecomputeHeap.fs"/>
    <Compile Include="AdjustHeightsHeap.fsi"/>
    <Compile Include="AdjustHeightsHeap.fs"/>
    <Compile Include="RunOnUpdateHandlers.fs"/>
    <Compile Include="OnlyInDebug.fs"/>
    <Compile Include="Clock.fs"/>
    <Compile Include="InternalObserverInvariant.fs"/>
    <Compile Include="State.fs"/>
    <Compile Include="ForAnalyzer.fsi"/>
    <Compile Include="ForAnalyzer.fs"/>
    <Compile Include="NodeToDot.fsi"/>
    <Compile Include="NodeToDot.fs"/>
    <Compile Include="Expert1.fsi"/>
    <Compile Include="Expert1.fs"/>
    <Compile Include="ReduceBalanced.fsi"/>
    <Compile Include="ReduceBalanced.fs"/>
    <Compile Include="Incremental.fsi"/>
    <Compile Include="Incremental.fs"/>
    <Compile Include="IncrementalBuilder.fsi"/>
    <Compile Include="IncrementalBuilder.fs"/>
    <Compile Include="Skeleton\RenderRelation.fs"/>
    <Compile Include="Skeleton\Node.fs"/>
    <Compile Include="Skeleton\Skeleton.fsi"/>
    <Compile Include="Skeleton\Skeleton.fs"/>
    <None Include="../logos/light.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <EmbeddedResource Include="SurfaceBaseline.txt"/>
    <EmbeddedResource Include="../version.json"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TypeEquality" Version="0.4.2"/>
    <PackageReference Include="WoofWare.BalancedReducer" Version="1.0.5" />
    <PackageReference Include="WoofWare.TimingWheel" Version="0.7.1" />
    <PackageReference Include="WoofWare.WeakHashTable" Version="1.2.2" />
    <PackageReference Update="FSharp.Core" Version="5.0.0"/>
  </ItemGroup>

  <!--
    nuget.org renders the packed readme through Markdig with DisableHtml(), which escapes raw
    HTML instead of dropping it, and it does not resolve relative image paths at all. The
    <picture> element that gives GitHub its light/dark logo would therefore appear on the
    package page as literal tags. Pack a copy with that element removed; on nuget.org the logo
    is carried by PackageIcon instead.
  -->
  <UsingTask TaskName="WriteReadmeWithoutLogo"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
string readme = File.ReadAllText(Source);
string stripped = Regex.Replace(readme, "<picture[^>]*>[\\s\\S]*?</picture>\\s*", "", RegexOptions.IgnoreCase);

// A <picture> the pattern above failed to match would reach the package page as literal tags, so
// check the strip did the job it claims to. Any other raw HTML in the readme leaks the same way,
// but recognising it reliably would mean reimplementing CommonMark's block grammar here.
if (Regex.IsMatch(stripped, "</?picture", RegexOptions.IgnoreCase))
{
    Log.LogError(
        "{0} still contains a <picture> element after the logo strip, so the packed readme would "
        + "show it on nuget.org as literal tags. Write the logo as a plain <picture> ... "
        + "</picture> block, or teach this task to match the form used.",
        Source);
}
else
{
    Directory.CreateDirectory(Path.GetDirectoryName(Destination));
    if (!File.Exists(Destination) || File.ReadAllText(Destination) != stripped)
    {
        File.WriteAllText(Destination, stripped);
    }
}
]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PackReadmeWithoutLogo" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <!-- IntermediateOutputPath is relative to the project by default but absolute under
           UseArtifactsOutput, so combine rather than prepend. -->
      <_NuGetReadme>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'nuget-readme', 'README.md'))</_NuGetReadme>
    </PropertyGroup>
    <WriteReadmeWithoutLogo Source="$(MSBuildProjectDirectory)/../README.md" Destination="$(_NuGetReadme)" />
    <ItemGroup>
      <None Include="$(_NuGetReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
